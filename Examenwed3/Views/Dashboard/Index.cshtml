@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container-fluid py-4 animate-in">
    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <h1 class="fw-bold display-6 mb-0 text-dark">
                <i class="bi bi-speedometer2 text-primary"></i> Panel <span class="text-primary text-opacity-75">Principal</span>
            </h1>
            <p class="text-muted fw-light">Resumen operativo del sistema de hospedaje.</p>
        </div>
        <div class="col-md-6 text-md-end text-muted">
            <div class="badge bg-white text-dark shadow-sm p-2 border">
                <i class="bi bi-calendar3 me-2 text-primary"></i> @DateTime.Now.ToString("dd MMMM, yyyy")
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100 card-glass" style="border-top: 5px solid #0d6efd !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted small text-uppercase fw-bold mb-1">Hoteles Registrados</p>
                            <h2 class="fw-bold mb-0">@ViewBag.TotalHoteles</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-building fs-3"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a href="/Hotels" class="btn btn-sm btn-outline-primary rounded-pill px-3">Administrar</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100 card-glass" style="border-top: 5px solid #198754 !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted small text-uppercase fw-bold mb-1">Reservas Totales</p>
                            <h2 class="fw-bold mb-0">@ViewBag.TotalReservas</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-calendar-check fs-3"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a href="/Reservas" class="btn btn-sm btn-outline-success rounded-pill px-3">Ver Listado</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100 card-glass" style="border-top: 5px solid #ffc107 !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted small text-uppercase fw-bold mb-1">Usuarios Activos</p>
                            <h2 class="fw-bold mb-0">@ViewBag.TotalUsuarios</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-people fs-3"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="badge bg-light text-warning border border-warning px-3 rounded-pill small">Acceso Identity</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-dark text-white p-4 overflow-hidden position-relative">
                <div class="row align-items-center position-relative" style="z-index: 2;">
                    <div class="col-md-8">
                        <h4 class="fw-bold">Acciones Rápidas del Administrador</h4>
                        <p class="text-white-50 mb-md-0">Genera reportes, añade nuevos destinos o revisa las últimas transacciones.</p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <div class="btn-group shadow-sm">
                            <a href="/Hotels/Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Nuevo Hotel</a>
                            <button onclick="window.print()" class="btn btn-light"><i class="bi bi-file-pdf me-1"></i> Reporte</button>
                        </div>
                    </div>
                </div>
                <i class="bi bi-briefcase-fill position-absolute text-white opacity-10" style="font-size: 150px; right: -20px; top: -30px; z-index: 1;"></i>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Animación suave al cargar */
        .animate-in {
            animation: fadeIn 0.6s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Efecto Glassmorphism */
        .card-glass {
            background: rgba(255, 255, 255, 0.9) !important;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

            .card-glass:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
            }

        .btn-group .btn {
            border-radius: 8px !important;
            margin-right: 6px;
        }
    </style>
}