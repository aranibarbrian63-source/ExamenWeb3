@model IEnumerable<Examenwed3.Models.Hotel>

@{
    ViewData["Title"] = "Gestión de Hoteles";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
            <h1 class="display-5 fw-bold text-primary"><i class="bi bi-building"></i> Hoteles</h1>
            <p class="text-muted mb-0">Administra la oferta de hospedajes disponibles en el sistema.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                <i class="bi bi-plus-circle"></i> Nuevo Hotel
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.Nombre)</th>
                            <th>@Html.DisplayNameFor(model => model.Direccion)</th>
                            <th class="text-center">@Html.DisplayNameFor(model => model.PrecioPorNoche)</th>
                            <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark">@Html.DisplayFor(modelItem => item.Nombre)</span>
                                </td>
                                <td>
                                    <i class="bi bi-geo-alt-fill text-danger"></i> @Html.DisplayFor(modelItem => item.Direccion)
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-success px-3 py-2">
                                        @item.PrecioPorNoche.ToString("C")
                                    </span>
                                </td>
                                <td class="text-truncate" style="max-width: 200px;">
                                    <small class="text-muted">@Html.DisplayFor(modelItem => item.Descripcion)</small>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4 text-center shadow-sm" role="alert">
            <i class="bi bi-info-circle-fill"></i> No hay hoteles registrados actualmente.
        </div>
    }
</div>

@section Scripts {
    <style>
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
            transition: 0.3s;
        }
        .btn-group .btn {
            border-width: 2px;
        }
    </style>
}